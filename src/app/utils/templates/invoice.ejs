<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Invoice</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .header {
      text-align: center;
      border-bottom: 2px solid #eee;
      padding-bottom: 15px;
      margin-bottom: 25px;
    }

    .header h1 {
      margin: 0;
      color: #222;
    }

    .badge {
      display: inline-block;
      padding: 5px 10px;
      background: #28a745;
      color: white;
      border-radius: 20px;
      font-size: 12px;
      margin-top: 8px;
    }

    .section {
      margin-bottom: 20px;
    }

    .row {
      display: flex;
      justify-content: space-between;
      margin: 8px 0;
      font-size: 14px;
    }

    .label {
      color: #666;
    }

    .value {
      font-weight: bold;
      color: #000;
    }

    .amount {
      font-size: 22px;
      color: #2ecc71;
      font-weight: bold;
    }

    .btn {
      display: inline-block;
      padding: 12px 20px;
      background: #007bff;
      color: #fff !important;
      text-decoration: none;
      border-radius: 6px;
      margin-top: 20px;
    }

    .footer {
      margin-top: 30px;
      font-size: 12px;
      color: #888;
      text-align: center;
    }

    .divider {
      height: 1px;
      background: #eee;
      margin: 20px 0;
    }
  </style>
</head>

<body>
  <div class="container">

    <!-- Header -->
    <div class="header">
      <h1>🧾 Invoice</h1>
      <div class="badge">Paid</div>
    </div>

    <!-- Customer Info -->


    <div class="divider"></div>

    <!-- Payment Info -->
    <div class="section">
      <div class="row">
        <span class="label">Payment ID</span>
  
      </div>

      <div class="row">
        <span class="label">Amount Paid</span>
     
      </div>
    </div>

    <div class="divider"></div>

    <!-- Message -->
    <p>
      Thank you for your booking! Your payment has been successfully completed.
    </p>

    <!-- Button -->

      📥 Download Invoice PDF
    </a>

    <!-- Footer -->
    <div class="footer">
      <p>If you have any questions, contact support anytime.</p>
      <p>© banglaTour. All rights reserved.</p>
    </div>

  </div>
</body>
</html>